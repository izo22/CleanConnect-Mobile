# Copy this file to .env and fill it in. Never commit .env.

# Address of Orbyn, without https:// (e.g. hq.my-agency.com).
# Point this domain to the server (DNS "A" record) before starting.
DOMAIN=

# Language of this instance: en (English, US dollars) or fr (French, euros).
APP_LANGUAGE=en
# Optional overrides: CURRENCY=USD|EUR|GBP|CAD…, TIMEZONE=America/Chicago…

# Access code for the dashboard, 16 characters minimum.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# AI review of the agents' answers (Claude). Leave empty to turn it off.
ANTHROPIC_API_KEY=

# Slack or Teams webhook to alert the people in charge (optional).
NOTIFY_WEBHOOK_URL=

# Backups and data retention (defaults shown).
BACKUP_KEEP_DAYS=30
RETENTION_DAYS=90

# true = start with the 100-agent demo instead of an empty workspace.
SEED_DEMO=false
