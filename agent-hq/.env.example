# Copy this file to .env and fill it in. Never commit .env.

# Address of Orvanta, without https:// (e.g. hq.my-agency.com).
# Point this domain to the server (DNS "A" record) before starting.
DOMAIN=

# Public website (optional), e.g. orvantahq.io. Point it and www to this server.
SITE_DOMAIN=

# Language of this instance: en (English, US dollars) or fr (French, euros).
APP_LANGUAGE=en
# Optional overrides: CURRENCY=USD|EUR|GBP|CAD…, TIMEZONE=America/Chicago…

# Setup code, 16 characters minimum: asked once, to create the first account
# (the platform administrator). Scripts can also send it as x-admin-token.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# open = visitors can create their own account and empty workspace
# (from the site's "Get started free" button). closed = invitation only.
SIGNUP=open

# "Continue with Google" (optional). Create them in Google Cloud: APIs & Services
# → Credentials → OAuth client ID (Web application), with the redirect URI
# https://<DOMAIN>/api/auth/google/callback. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI review of the agents' answers (Claude). Leave empty to turn it off.
ANTHROPIC_API_KEY=

# Slack or Teams webhook to alert the people in charge (optional).
NOTIFY_WEBHOOK_URL=

# Backups and data retention (defaults shown).
BACKUP_KEEP_DAYS=30
RETENTION_DAYS=90

# true = start with the 100-agent demo instead of an empty workspace.
SEED_DEMO=false
